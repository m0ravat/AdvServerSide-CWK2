        // Courses by Month 2026 Bar Chart (NEW)
        const courseMonths = Object.keys(data.courseAnalytics.coursesByMonth2026);
        const courseMonthValues = courseMonths.map(m => data.courseAnalytics.coursesByMonth2026[m]);
        createBarChart('coursesByMonth2026Chart', courseMonths, courseMonthValues, colorPalettes.bars, courseMonthValues.reduce((a, b) => a + b, 0));

        // Jobs Per Profile Bar Chart
        const jobLabels = ['1 Job', '1-3 Jobs', '3-5 Jobs', '5-9 Jobs', '10+ Jobs'];
        const jobValues = [
            data.employmentHistoryAnalytics.jobsPerProfile.oneJob, 

        const certMonthValues = certMonths.map(m => data.certificationAnalytics.certificationsByMonth2026[m]);
        createBarChart('certsByMonth2026Chart', certMonths, certMonthValues, colorPalettes.bars, certMonthValues.reduce((a, b) => a + b, 0));


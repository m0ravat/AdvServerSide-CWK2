        const licenseMonthValues = licenseMonths.map(m => data.licenseAnalytics.licensesByMonth2026[m]);
        createBarChart('licensesByMonth2026Chart', licenseMonths, licenseMonthValues, colorPalettes.bars, licenseMonthValues.reduce((a, b) => a + b, 0));

        // Top Course Providers Horizontal Bar (NEW)

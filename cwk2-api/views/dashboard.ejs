<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Alumni Analytics</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #f5f7fa;
            min-height: 100vh;
            padding: 20px;
        }

        .navbar {
            background: white;
            padding: 16px 20px;
            border-radius: 8px;
            margin-bottom: 30px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar h1 {
            font-size: 20px;
            color: #333;
        }

        .navbar a {
            color: #667eea;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: color 0.2s;
        }

        .navbar a:hover {
            color: #764ba2;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .welcome-section {
            background: white;
            padding: 30px;
            border-radius: 8px;
            margin-bottom: 30px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .welcome-section h2 {
            font-size: 24px;
            color: #333;
            margin-bottom: 8px;
        }

        .welcome-section p {
            color: #666;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .user-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        .user-card-content {
            margin-bottom: 12px;
        }

        .user-card label {
            font-size: 12px;
            opacity: 0.9;
        }

        .user-card .value {
            font-size: 16px;
            font-weight: 600;
            margin-top: 4px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            padding: 24px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .stat-card h3 {
            font-size: 14px;
            color: #666;
            font-weight: 600;
            margin-bottom: 16px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
        }

        .stat-item:last-child {
            border-bottom: none;
        }

        .stat-label {
            color: #666;
        }

        .stat-value {
            font-weight: 600;
            color: #333;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: #666;
        }

        .error {
            background-color: #fee;
            border: 1px solid #fcc;
            color: #c33;
            padding: 16px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        @media (max-width: 768px) {
            .navbar {
                flex-direction: column;
                gap: 12px;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .welcome-section {
                padding: 20px;
            }

            .welcome-section h2 {
                font-size: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="navbar">
        <h1>Alumni Analytics Dashboard</h1>
        <a href="/account/logout">Logout</a>
    </div>

    <div class="container">
        <div class="welcome-section">
            <h2>Welcome, <%= user.fullname %>!</h2>
            <p>Here's an overview of alumni profile statistics.</p>

            <div class="user-card">
                <div class="user-card-content">
                    <label>Email</label>
                    <div class="value"><%= user.email %></div>
                </div>
                <div class="user-card-content">
                    <label>Account Created</label>
                    <div class="value"><%= new Date(user._id.getTimestamp()).toLocaleDateString() %></div>
                </div>
            </div>
        </div>

        <div id="analytics-container">
            <div class="loading">Loading analytics...</div>
        </div>
    </div>

    <script>
        async function loadAnalytics() {
            try {
                const response = await fetch('/cwk2/analytics/stats');
                const data = await response.json();

                if (response.ok) {
                    renderAnalytics(data);
                } else {
                    showError('Failed to load analytics');
                }
            } catch (error) {
                console.error('Error loading analytics:', error);
                showError('Error loading analytics. Please refresh the page.');
            }
        }

        function renderAnalytics(data) {
            const container = document.getElementById('analytics-container');
            const html = `
                <div class="stats-grid">
                    <!-- Employment Stats -->
                    <div class="stat-card">
                        <h3>Employment Status</h3>
                        <div class="stat-item">
                            <span class="stat-label">Employed</span>
                            <span class="stat-value">${data.employment.employed}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Not Employed</span>
                            <span class="stat-value">${data.employment.notEmployed}</span>
                        </div>
                    </div>

                    <!-- LinkedIn Stats -->
                    <div class="stat-card">
                        <h3>LinkedIn Profile</h3>
                        <div class="stat-item">
                            <span class="stat-label">Has LinkedIn</span>
                            <span class="stat-value">${data.linkedIn.hasLinkedIn}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">No LinkedIn</span>
                            <span class="stat-value">${data.linkedIn.noLinkedIn}</span>
                        </div>
                    </div>

                    <!-- Degree Stats -->
                    <div class="stat-card">
                        <h3>Education Level</h3>
                        <div class="stat-item">
                            <span class="stat-label">No Degree</span>
                            <span class="stat-value">${data.degrees.noDegrees}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">1 Degree</span>
                            <span class="stat-value">${data.degrees.oneDegree}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">2 Degrees</span>
                            <span class="stat-value">${data.degrees.twoDegrees}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">3+ Degrees</span>
                            <span class="stat-value">${data.degrees.threePlusDegrees}</span>
                        </div>
                    </div>

                    <!-- Time to Find Job -->
                    <div class="stat-card">
                        <h3>Time to Find Job</h3>
                        <div class="stat-item">
                            <span class="stat-label">≤ 30 days</span>
                            <span class="stat-value">${data.timeToFindJob.thirtyDaysOrLess}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">30 days - 6 months</span>
                            <span class="stat-value">${data.timeToFindJob.thirtyDaysToSixMonths}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">6 months - 1 year</span>
                            <span class="stat-value">${data.timeToFindJob.sixMonthsToOneYear}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">1 - 2 years</span>
                            <span class="stat-value">${data.timeToFindJob.oneYearToTwoYears}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">2 - 5 years</span>
                            <span class="stat-value">${data.timeToFindJob.twoYearsToFiveYears}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">5+ years</span>
                            <span class="stat-value">${data.timeToFindJob.fiveYearsPlus}</span>
                        </div>
                    </div>

                    <!-- Location Stats -->
                    <div class="stat-card">
                        <h3>Alumni Location</h3>
                        <div class="stat-item">
                            <span class="stat-label">London</span>
                            <span class="stat-value">${data.locations.London}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">England</span>
                            <span class="stat-value">${data.locations.England}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">UK</span>
                            <span class="stat-value">${data.locations.UK}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Scotland</span>
                            <span class="stat-value">${data.locations.Scotland}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Ireland</span>
                            <span class="stat-value">${data.locations.Ireland}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Asia</span>
                            <span class="stat-value">${data.locations.Asia}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Africa</span>
                            <span class="stat-value">${data.locations.Africa}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">South America</span>
                            <span class="stat-value">${data.locations.SouthAmerica}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">North America</span>
                            <span class="stat-value">${data.locations.NorthAmerica}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Europe</span>
                            <span class="stat-value">${data.locations.Europe}</span>
                        </div>
                    </div>

                    <!-- Credentials Stats -->
                    <div class="stat-card">
                        <h3>Certifications & Courses</h3>
                        <div class="stat-item">
                            <span class="stat-label">None</span>
                            <span class="stat-value">${data.credentials.noCertifications}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">1-5 Credentials</span>
                            <span class="stat-value">${data.credentials.oneToFiveCertifications}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">6-10 Credentials</span>
                            <span class="stat-value">${data.credentials.sixToTenCertifications}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">10+ Credentials</span>
                            <span class="stat-value">${data.credentials.tenPlusCertifications}</span>
                        </div>
                    </div>
                </div>

                <div class="stats-grid" style="margin-top: 10px;">
                    <div class="stat-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                        <div class="stat-item" style="border-bottom-color: rgba(255,255,255,0.2);">
                            <span class="stat-label" style="color: rgba(255,255,255,0.8);">Total Alumni Profiles</span>
                            <span class="stat-value" style="color: white; font-size: 28px;">${data.totalProfiles}</span>
                        </div>
                    </div>
                </div>
            `;
            container.innerHTML = html;
        }

        function showError(message) {
            const container = document.getElementById('analytics-container');
            container.innerHTML = `<div class="error">${message}</div>`;
        }

        // Load analytics on page load
        loadAnalytics();
    </script>
</body>
</html>

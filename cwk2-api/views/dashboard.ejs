            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: {
                    duration: 2000,
                    easing: 'easeInOutQuart'
                },
                interaction: {
                    intersect: false,
                    mode: 'index'
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        titleFont: { size: 14, weight: 'bold' },
                        bodyFont: { size: 13 },
                        padding: 12,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                const value = context.raw;
                                const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                return label + ': ' + value + ' (' + percentage + '% of total)';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0, 0, 0, 0.05)' },
                        ticks: { font: { size: 11 } }
                    },
                    x: {
                        grid: { color: 'rgba(0, 0, 0, 0.05)' },
                        ticks: { font: { size: 11 } }
                    }
                }
            }
        });
    }

    // Radar Chart - improved spacing
    function createRadarChart(canvasId, labels, data) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;

        if (chartInstances[canvasId]) {
            chartInstances[canvasId].destroy();
        }

        const total = data.reduce((a, b) => a + b, 0);
        const maxValue = Math.max(...data);
        const suggestedMax = maxValue <= 10 ? Math.ceil(maxValue / 2) * 2 + 2 : 
                             maxValue <= 50 ? Math.ceil(maxValue / 10) * 10 + 10 :
                             Math.ceil(maxValue / 25) * 25 + 25;
        const stepSize = suggestedMax <= 10 ? 2 : 
                         suggestedMax <= 50 ? 10 : 
                         suggestedMax <= 100 ? 25 : 50;

        chartInstances[canvasId] = new Chart(ctx, {
            type: 'radar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Alumni Count',
                    data: data,
                    backgroundColor: 'rgba(66, 133, 244, 0.25)',
                    borderColor: '#4285F4',
                    borderWidth: 2.5,
                    pointBackgroundColor: '#4285F4',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 8,
                    pointHoverBackgroundColor: '#4285F4',
                    pointHoverBorderColor: '#fff',
                    pointHoverBorderWidth: 3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: {
                    duration: 1500,
                    easing: 'easeOutQuad'
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        titleFont: { size: 14, weight: 'bold' },
                        bodyFont: { size: 13 },
                        padding: 12,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                const value = context.raw;
                                const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                return 'Count: ' + value + ' (' + percentage + '%)';
                            }
                        }
                    }
                },
                scales: {
                    r: {
                        beginAtZero: true,
                        suggestedMin: 0,
                        suggestedMax: suggestedMax,
                        angleLines: { 
                            color: 'rgba(0, 0, 0, 0.1)',
                            lineWidth: 1
                        },
                        grid: { 
                            color: 'rgba(0, 0, 0, 0.08)',
                            circular: false
                        },
                        pointLabels: { 
                            font: { size: 12, weight: '500' },
                            color: '#444',
                            padding: 20
                        },
                        ticks: { 
                            backdropColor: 'transparent',
                            font: { size: 10 },
                            color: '#888',
                            stepSize: stepSize,
                            showLabelBackdrop: false
                        }
                    }
                }
            }
        });
    }

    // Utility: Adjust color brightness
    function adjustColorBrightness(hex, percent) {
        const num = parseInt(hex.replace('#', ''), 16);
        const amt = Math.round(2.55 * percent);
        const R = (num >> 16) + amt;
        const G = (num >> 8 & 0x00FF) + amt;
        const B = (num & 0x0000FF) + amt;
        return '#' + (0x1000000 + (R < 255 ? R < 1 ? 0 : R : 255) * 0x10000 +
            (G < 255 ? G < 1 ? 0 : G : 255) * 0x100 +
            (B < 255 ? B < 1 ? 0 : B : 255)).toString(16).slice(1);
    }

    // Utility: Hex to RGBA
    function hexToRgba(hex, alpha) {
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        return 'rgba(' + r + ', ' + g + ', ' + b + ', ' + alpha + ')';
    }

    function createStatCard(label, value, total) {
        const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
        return '<div class="stat-card">' +
            '<h3>' + label + '</h3>' +
            '<div class="value">' + value + '</div>' +
            '<div class="percentage">' + percentage + '% of total</div>' +
            '</div>';
    }

    // Load analytics on page load
    document.addEventListener('DOMContentLoaded', loadAnalytics);
</script>
